#include <dt-bindings/pinctrl/nrf-pinctrl.h>

/ {
    /* Required binding for ZMK Studio: must be 7 cells */
    key_physical_attrs: key-physical-attrs {
        compatible = "zmk,key-physical-attrs";
        #key-cells = <7>;
    };

    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
        zmk,underglow = &led_strip;
        zmk,physical-layout = &physical_layout0;
    };

    led_power: led_power {
        compatible = "zmk,ext-power-generic";
        control-gpios = <&gpio1 6 GPIO_ACTIVE_HIGH>;
        init-delay-ms = <50>;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        row-gpios = <&gpio0 6  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&gpio0 8  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&gpio0 17 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&gpio0 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&gpio0 22 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&gpio0 24 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&gpio1 0  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&gpio0 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&gpio1 4  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;

        col-gpios = <&gpio0 29 GPIO_ACTIVE_HIGH>,
                    <&gpio0 2  GPIO_ACTIVE_HIGH>,
                    <&gpio1 15 GPIO_ACTIVE_HIGH>,
                    <&gpio1 13 GPIO_ACTIVE_HIGH>,
                    <&gpio1 11 GPIO_ACTIVE_HIGH>,
                    <&gpio0 10 GPIO_ACTIVE_HIGH>,
                    <&gpio0 9  GPIO_ACTIVE_HIGH>;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <7>;
        rows = <9>;
        /* values are RC(row,col) pre-expanded as (row<<8)+col */
        map = <
            0    1    2    3    4    5    6      1280 1281 1282 1283 1284 1285 1286
            256  257  258  259  260  261  262    1536 1537 1538 1539 1540 1541 1542
            512  513  514  515  516  517  518    1792 1793 1794 1795 1796      1797
            768  769  770  771  772  773  774    2048 2049 2050 2051 2052 1798
                                                                          2053
            1024 1025 1026      1027      1028
                                                                  1029 1030 2054
        >;
    };

    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "Default Layout";
        transform = <&default_transform>;
        kscan = <&kscan0>;
        keys
            = <&key_physical_attrs 0 0 100 100 0 0 0>, <&key_physical_attrs 100 0 100 100 0 0 0>, <&key_physical_attrs 200 0 100 100 0 0 0>, <&key_physical_attrs 300 0 100 100 0 0 0>, <&key_physical_attrs 400 0 100 100 0 0 0>, <&key_physical_attrs 500 0 100 100 0 0 0>, <&key_physical_attrs 600 0 100 100 0 0 0>, <&key_physical_attrs 700 0 100 100 0 0 0>, <&key_physical_attrs 800 0 100 100 0 0 0>, <&key_physical_attrs 900 0 100 100 0 0 0>, <&key_physical_attrs 1000 0 100 100 0 0 0>, <&key_physical_attrs 1100 0 100 100 0 0 0>, <&key_physical_attrs 1200 0 100 100 0 0 0>, <&key_physical_attrs 1300 0 100 100 0 0 0>
            , <&key_physical_attrs 0 100 100 100 0 0 0>, <&key_physical_attrs 100 100 100 100 0 0 0>, <&key_physical_attrs 200 100 100 100 0 0 0>, <&key_physical_attrs 300 100 100 100 0 0 0>, <&key_physical_attrs 400 100 100 100 0 0 0>, <&key_physical_attrs 500 100 100 100 0 0 0>, <&key_physical_attrs 600 100 100 100 0 0 0>, <&key_physical_attrs 700 100 100 100 0 0 0>, <&key_physical_attrs 800 100 100 100 0 0 0>, <&key_physical_attrs 900 100 100 100 0 0 0>, <&key_physical_attrs 1000 100 100 100 0 0 0>, <&key_physical_attrs 1100 100 100 100 0 0 0>, <&key_physical_attrs 1200 100 100 100 0 0 0>, <&key_physical_attrs 1300 100 100 100 0 0 0>
            , <&key_physical_attrs 0 200 100 100 0 0 0>, <&key_physical_attrs 100 200 100 100 0 0 0>, <&key_physical_attrs 200 200 100 100 0 0 0>, <&key_physical_attrs 300 200 100 100 0 0 0>, <&key_physical_attrs 400 200 100 100 0 0 0>, <&key_physical_attrs 500 200 100 100 0 0 0>, <&key_physical_attrs 600 200 100 100 0 0 0>, <&key_physical_attrs 700 200 100 100 0 0 0>, <&key_physical_attrs 800 200 100 100 0 0 0>, <&key_physical_attrs 900 200 100 100 0 0 0>, <&key_physical_attrs 1000 200 100 100 0 0 0>, <&key_physical_attrs 1100 200 100 100 0 0 0>, <&key_physical_attrs 1200 200 200 100 0 0 0>
            , <&key_physical_attrs 0 300 100 100 0 0 0>, <&key_physical_attrs 100 300 100 100 0 0 0>, <&key_physical_attrs 200 300 100 100 0 0 0>, <&key_physical_attrs 300 300 100 100 0 0 0>, <&key_physical_attrs 400 300 100 100 0 0 0>, <&key_physical_attrs 500 300 100 100 0 0 0>, <&key_physical_attrs 600 300 100 100 0 0 0>, <&key_physical_attrs 700 300 100 100 0 0 0>, <&key_physical_attrs 800 300 100 100 0 0 0>, <&key_physical_attrs 900 300 100 100 0 0 0>, <&key_physical_attrs 1000 300 100 100 0 0 0>, <&key_physical_attrs 1100 300 100 100 0 0 0>, <&key_physical_attrs 1200 300 100 100 0 0 0>, <&key_physical_attrs 1300 300 100 100 0 0 0>
            , <&key_physical_attrs 0 400 100 100 0 0 0>, <&key_physical_attrs 100 400 100 100 0 0 0>, <&key_physical_attrs 200 400 100 100 0 0 0>, <&key_physical_attrs 400 400 200 100 0 0 0>, <&key_physical_attrs 600 400 100 100 0 0 0>, <&key_physical_attrs 1100 400 100 100 0 0 0>, <&key_physical_attrs 1200 400 100 100 0 0 0>, <&key_physical_attrs 1300 400 100 100 0 0 0>;
    };
};

&pinctrl {
    spi1_default: spi1_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 2)>,
                    <NRF_PSEL(SPIM_MOSI, 1, 7)>;
        };
    };
    spi1_sleep: spi1_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 2)>,
                    <NRF_PSEL(SPIM_MOSI, 1, 7)>;
            low-power-enable;
        };
    };

    spi3_default: spi3_default {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 31)>;
        };
    };
    spi3_sleep: spi3_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 31)>;
            low-power-enable;
        };
    };
};

/* Explicit label definition required for shield */
nice_view_spi: &spi1 {
    status = "okay";
    pinctrl-0 = <&spi1_default>;
    pinctrl-1 = <&spi1_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio1 1 GPIO_ACTIVE_HIGH>;
};

&spi3 {
    status = "okay";
    pinctrl-0 = <&spi3_default>;
    pinctrl-1 = <&spi3_sleep>;
    pinctrl-names = "default", "sleep";

    led_strip: ws2812@0 {
        compatible = "worldsemi,ws2812-spi";
        reg = <0>;
        spi-max-frequency = <4000000>;
        chain-length = <63>;
        spi-one-frame = <0x70>;
        spi-zero-frame = <0x40>;
        color-mapping = <0 1 2>;
    };
};
