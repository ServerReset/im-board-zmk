#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/pinctrl/nrf-pinctrl.h>

/ {
    /* Required binding for ZMK Studio physical attributes */
    key_physical_attrs: key-physical-attrs {
        compatible = "zmk,key-physical-attrs";
        #key-cells = <4>;
    };

    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
        zmk,underglow = &led_strip;
        zmk,physical-layout = &physical_layout0;
    };

    led_power: led_power {
        compatible = "zmk,ext-power-generic";
        control-gpios = <&gpio1 6 GPIO_ACTIVE_HIGH>;
        init-delay-ms = <50>;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        row-gpios = <&gpio0 6  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&gpio0 8  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&gpio0 17 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&gpio0 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&gpio0 22 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&gpio0 24 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&gpio1 0  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&gpio0 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&gpio1 4  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;

        col-gpios = <&gpio0 29 GPIO_ACTIVE_HIGH>,
                    <&gpio0 2  GPIO_ACTIVE_HIGH>,
                    <&gpio1 15 GPIO_ACTIVE_HIGH>,
                    <&gpio1 13 GPIO_ACTIVE_HIGH>,
                    <&gpio1 11 GPIO_ACTIVE_HIGH>,
                    <&gpio0 10 GPIO_ACTIVE_HIGH>,
                    <&gpio0 9  GPIO_ACTIVE_HIGH>;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <7>;
        rows = <9>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6)   RC(5,0) RC(5,1) RC(5,2) RC(5,3) RC(5,4) RC(5,5) RC(5,6)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6)   RC(6,0) RC(6,1) RC(6,2) RC(6,3) RC(6,4) RC(6,5) RC(6,6)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6)   RC(7,0) RC(7,1) RC(7,2) RC(7,3) RC(7,4)         RC(7,5)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6)   RC(8,0) RC(8,1) RC(8,2) RC(8,3) RC(8,4) RC(7,6)
                                                                                                              RC(8,5)
            RC(4,0) RC(4,1) RC(4,2)         RC(4,3)         RC(4,4)
                                                                                                      RC(4,5) RC(4,6) RC(8,6)
        >;
    };

    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "Default Layout";
        transform = <&default_transform>;
        kscan = <&kscan0>;
        keys = <&key_physical_attrs 0 0 100 100>, <&key_physical_attrs 100 0 100 100>, <&key_physical_attrs 200 0 100 100>, <&key_physical_attrs 300 0 100 100>, <&key_physical_attrs 400 0 100 100>, <&key_physical_attrs 500 0 100 100>, <&key_physical_attrs 600 0 100 100>, <&key_physical_attrs 700 0 100 100>, <&key_physical_attrs 800 0 100 100>, <&key_physical_attrs 900 0 100 100>, <&key_physical_attrs 1000 0 100 100>, <&key_physical_attrs 1100 0 100 100>, <&key_physical_attrs 1200 0 100 100>, <&key_physical_attrs 1300 0 100 100>
             , <&key_physical_attrs 0 100 100 100>, <&key_physical_attrs 100 100 100 100>, <&key_physical_attrs 200 100 100 100>, <&key_physical_attrs 300 100 100 100>, <&key_physical_attrs 400 100 100 100>, <&key_physical_attrs 500 100 100 100>, <&key_physical_attrs 600 100 100 100>, <&key_physical_attrs 700 100 100 100>, <&key_physical_attrs 800 100 100 100>, <&key_physical_attrs 900 100 100 100>, <&key_physical_attrs 1000 100 100 100>, <&key_physical_attrs 1100 100 100 100>, <&key_physical_attrs 1200 100 100 100>, <&key_physical_attrs 1300 100 100 100>
             , <&key_physical_attrs 0 200 100 100>, <&key_physical_attrs 100 200 100 100>, <&key_physical_attrs 200 200 100 100>, <&key_physical_attrs 300 200 100 100>, <&key_physical_attrs 400 200 100 100>, <&key_physical_attrs 500 200 100 100>, <&key_physical_attrs 600 200 100 100>, <&key_physical_attrs 700 200 100 100>, <&key_physical_attrs 800 200 100 100>, <&key_physical_attrs 900 200 100 100>, <&key_physical_attrs 1000 200 100 100>, <&key_physical_attrs 1100 200 100 100>, <&key_physical_attrs 1200 200 200 100>
             , <&key_physical_attrs 0 300 100 100>, <&key_physical_attrs 100 300 100 100>, <&key_physical_attrs 200 300 100 100>, <&key_physical_attrs 300 300 100 100>, <&key_physical_attrs 400 300 100 100>, <&key_physical_attrs 500 300 100 100>, <&key_physical_attrs 600 300 100 100>, <&key_physical_attrs 700 300 100 100>, <&key_physical_attrs 800 300 100 100>, <&key_physical_attrs 900 300 100 100>, <&key_physical_attrs 1000 300 100 100>, <&key_physical_attrs 1100 300 100 100>, <&key_physical_attrs 1200 300 100 100>, <&key_physical_attrs 1300 300 100 100>
             , <&key_physical_attrs 0 400 100 100>, <&key_physical_attrs 100 400 100 100>, <&key_physical_attrs 200 400 100 100>, <&key_physical_attrs 400 400 200 100>, <&key_physical_attrs 600 400 100 100>, <&key_physical_attrs 1100 400 100 100>, <&key_physical_attrs 1200 400 100 100>, <&key_physical_attrs 1300 400 100 100>;
    };
};

&spi1 {
    compatible = "nordic,nrf-spim";
    status = "okay";
    pinctrl-0 = <&spi1_default>;
    pinctrl-1 = <&spi1_sleep>;
    pinctrl-names = "default", "sleep";
    
    nice_view_spi: &spi1 {
        label = "nice_view_spi";
    };
};

&pinctrl {
    spi1_default: spi1_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 2)>,
                    <NRF_PSEL(SPIM_MOSI, 1, 7)>;
        };
    };
    spi1_sleep: spi1_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 2)>,
                    <NRF_PSEL(SPIM_MOSI, 1, 7)>;
            low-power-enable;
        };
    };

    spi3_default: spi3_default {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 31)>;
        };
    };
    spi3_sleep: spi3_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 31)>;
            low-power-enable;
        };
    };
};
